# Supabase (required for app + backend)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL. Optional in dev. REQUIRED in production (Rork + Railway).
# Must point to the BACKEND service domain (e.g. Railway backend URL), NOT the frontend.
# No trailing slash. Do not use localhost for production builds.
# Prefer EXPO_PUBLIC_API_URL; EXPO_PUBLIC_API_BASE_URL is also supported.
# EXPO_PUBLIC_API_URL=https://your-backend.up.railway.app
# EXPO_PUBLIC_API_BASE_URL=

# Backend-only (when running backend/server.ts or deploying to Railway)
# PORT=8080
# NODE_ENV=production
# CORS_ORIGIN=https://your-app-origin.com
# Secret for cron endpoints (query ?secret=, Bearer, or POST x-cron-secret for /internal/daily-reset). Set a long random value in production.
# CRON_SECRET=

# Supabase service role (backend only). Required for admin ops (e.g. delete auth user on account deletion, cron). Never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional): rate limiting + response cache (getFeatured, weekly leaderboard). If unset, limits are in-memory and cache is skipped.
# DATABASE_URL / SUPABASE_DB_URL: use Supabase Transaction pooler URL on Railway (host contains pooler, port 6543) — not required for the JS client but useful for logs/migrations.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional override for global per-minute cap (default 100).
# RATE_LIMIT_MAX_PER_MIN=
# RevenueCat secret API key (server-side subscription validation). If unset, validation is skipped and current DB values are returned.
# REVENUECAT_API_KEY=

# RevenueCat public SDK keys (from app.revenuecat.com -> API Keys -> SDK API keys)
# iOS key starts with appl_, Android key starts with goog_
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry (error reporting). If unset, Sentry is not initialized.
# Get your DSN from: https://sentry.io → New Project → React Native
# Paste the DSN value after the = sign
# EXPO_PUBLIC_SENTRY_DSN=
# Optional: Sentry DSN for backend error reporting
# SENTRY_DSN_BACKEND=

# PostHog (analytics). If unset, events are not sent; app works normally.
# EXPO_PUBLIC_POSTHOG_API_KEY=your_posthog_api_key_here
# Set to "true" to send PostHog events from __DEV__ builds (default: off in dev).
# EXPO_PUBLIC_POSTHOG_ENABLE_DEV=false

# RevenueCat legacy key aliases (fallbacks used when the _KEY vars above are absent).
# Only needed if you previously used the _API_KEY naming; prefer _KEY variants above.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Error reporting webhook (optional). POSTs error payloads to your own endpoint.
# EXPO_PUBLIC_ERROR_REPORT_URL=   # client-side (lib/client-error-reporting.ts)
# ERROR_REPORT_URL=               # backend-side (backend/lib/error-reporting.ts)

# Strava OAuth integration (backend only; gated by PREMIUM_INTEGRATIONS flag).
# Required only when PREMIUM_INTEGRATIONS is enabled.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=https://your-backend.up.railway.app/api/auth/strava/callback
# STRAVA_OAUTH_STATE_SECRET=      # separate HMAC secret; falls back to STRAVA_CLIENT_SECRET if unset
# STRAVA_SUCCESS_REDIRECT_URI=https://griit.app/profile?strava=connected
# STRAVA_ERROR_REDIRECT_URI=https://griit.app/profile?strava=error

# Backend runtime / observability (all optional; sensible defaults apply when unset).
# LOG_LEVEL=info                  # backend logger level (backend/lib/logger.ts); default "info"
# REQUEST_BODY_MAX_BYTES=1000000  # max request body size in bytes; default 1 MB
# GIT_COMMIT_SHA=                 # injected automatically by Railway/Vercel; set manually for other hosts
# RAILWAY_GIT_COMMIT_SHA=         # set automatically by Railway
# VERCEL_GIT_COMMIT_SHA=          # set automatically by Vercel
